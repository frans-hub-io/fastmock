{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "fastmock chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "logFormat": {
      "type": "string",
      "enum": [
        "json",
        "text"
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pluginSettings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "tokensSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            },
            "key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uiDataPlaneUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "permissions"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "description": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]+:([a-z]+|\\*)$"
                }
              }
            }
          }
        },
        "spaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
              },
              "description": {
                "type": "string",
                "maxLength": 1024
              },
              "pathPrefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mailDomains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^(\\*\\.)?[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"
                }
              }
            }
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subject",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^(token|user|group):.+$"
              },
              "role": {
                "type": "string"
              },
              "spaces": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(\\*|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$"
                }
              },
              "global": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^$|^https://[^/?#]+"
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            },
            "key": {
              "type": "string",
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "additionalProperties": false
        },
        "redirectUrl": {
          "type": "string",
          "pattern": "^$|^https://[^/?#]+/__admin/auth/callback$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claims": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "groups": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "apiAudience": {
          "type": "string"
        },
        "trustOutboundCA": {
          "type": "boolean"
        },
        "session": {
          "type": "object",
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d)?$"
            },
            "idle": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d)?$"
            }
          },
          "additionalProperties": false
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "callbacks": {
      "type": "object",
      "properties": {
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedCidrs": {
          "type": "string"
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)?$"
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "stubSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractSecrets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "outboundCA": {
      "type": "object",
      "properties": {
        "configMap": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)?$"
        },
        "maxBodyBytes": {
          "type": "integer"
        },
        "queue": {
          "type": "integer"
        },
        "scanTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)?$"
        },
        "scanMaxWork": {
          "type": "integer"
        },
        "scanConcurrency": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxBodyBytes": {
          "type": "integer"
        },
        "maxInflightBodyBytes": {
          "type": "integer"
        },
        "maxDelay": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)?$"
        },
        "recordingMaxStubs": {
          "type": "integer"
        },
        "headerReadTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)?$"
        }
      },
      "additionalProperties": false
    },
    "messaging": {
      "type": "object",
      "properties": {
        "kafka": {
          "type": "object",
          "properties": {
            "bootstrap": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^:\\s]+:[0-9]{1,5}$"
              }
            },
            "securityProtocol": {
              "type": "string",
              "enum": [
                "",
                "plaintext",
                "ssl",
                "sasl_plaintext",
                "sasl_ssl",
                "PLAINTEXT",
                "SSL",
                "SASL_PLAINTEXT",
                "SASL_SSL"
              ]
            },
            "sasl": {
              "type": "object",
              "properties": {
                "mechanism": {
                  "type": "string",
                  "enum": [
                    "",
                    "PLAIN",
                    "SCRAM-SHA-256",
                    "SCRAM-SHA-512",
                    "plain",
                    "scram-sha-256",
                    "scram-sha-512"
                  ]
                },
                "username": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                },
                "passwordKey": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "tls": {
              "type": "object",
              "properties": {
                "caSecret": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                },
                "caKey": {
                  "type": "string"
                },
                "clientCertSecret": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "schemaRegistry": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^$|^https?://"
                },
                "username": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                },
                "passwordKey": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "allowedTopics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contractTopics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "createTopics": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "partitions": {
                  "type": "integer",
                  "minimum": 1
                },
                "replication": {
                  "type": "integer",
                  "minimum": -1,
                  "not": {
                    "const": 0
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "mqtt": {
          "type": "object",
          "description": "The MQTT broker stubs and async mocks publish to and capture sources read from. Nothing is rendered without url.",
          "properties": {
            "url": {
              "type": "string",
              "description": "mqtt://host:1883 or mqtts://host:8883, without credentials or path.",
              "pattern": "^$|^mqtts?://[^/@?#\\s]+/?$"
            },
            "version": {
              "description": "MQTT protocol version.",
              "enum": [
                "5",
                "3.1.1",
                5
              ]
            },
            "clientIdPrefix": {
              "type": "string",
              "description": "Prefix of the client ids FastMock connects with.",
              "minLength": 1,
              "maxLength": 40
            },
            "keepAlive": {
              "type": "string",
              "description": "Keep-alive interval.",
              "pattern": "^[0-9]+(ms|s|m|h|d)?$"
            },
            "username": {
              "type": "string",
              "description": "User name; the password comes from existingSecret."
            },
            "existingSecret": {
              "type": "string",
              "description": "Secret holding the password under passwordKey.",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "maxLength": 253
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "tls": {
              "type": "object",
              "description": "CA and client certificate for mqtts:// URLs, mounted from Secrets.",
              "properties": {
                "caSecret": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                },
                "caKey": {
                  "type": "string"
                },
                "clientCertSecret": {
                  "type": "string",
                  "description": "kubernetes.io/tls Secret with tls.crt and tls.key.",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "allowedTopics": {
              "type": "array",
              "description": "Topics stubs and async mocks may publish to (name or prefix*); empty allows all.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "amqp": {
          "type": "object",
          "description": "The AMQP 0-9-1 broker stubs and async mocks publish to and capture sources read from. Nothing is rendered without url.",
          "properties": {
            "url": {
              "type": "string",
              "description": "amqp://host:5672/vhost or amqps://host:5671/vhost with a URL-encoded vhost, without credentials.",
              "pattern": "^$|^amqps?://[^/@?#\\s]+(/[^/@?#\\s]*)?$"
            },
            "sasl": {
              "type": "object",
              "properties": {
                "mechanism": {
                  "type": "string",
                  "description": "PLAIN (the default) or EXTERNAL, which needs an amqps:// URL and tls.clientCertSecret.",
                  "enum": [
                    "",
                    "PLAIN",
                    "EXTERNAL",
                    "plain",
                    "external"
                  ]
                },
                "username": {
                  "type": "string",
                  "description": "User name for PLAIN; the password comes from existingSecret."
                },
                "existingSecret": {
                  "type": "string",
                  "description": "Secret holding the password under passwordKey.",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                },
                "passwordKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "tls": {
              "type": "object",
              "description": "CA and client certificate for amqps:// URLs, mounted from Secrets.",
              "properties": {
                "caSecret": {
                  "type": "string",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                },
                "caKey": {
                  "type": "string"
                },
                "clientCertSecret": {
                  "type": "string",
                  "description": "kubernetes.io/tls Secret with tls.crt and tls.key.",
                  "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "allowedExchanges": {
              "type": "array",
              "description": "Exchanges stubs and async mocks may publish to (name or prefix*); empty allows all.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "declareExchanges": {
              "type": "boolean",
              "description": "Declare missing exchanges before publishing."
            }
          },
          "additionalProperties": false
        },
        "capture": {
          "type": "object",
          "description": "Capture of the messages an application publishes to Kafka, MQTT or AMQP.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sources": {
              "type": "array",
              "description": "Capture sources defined by configuration, rendered into a ConfigMap file.",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "protocol"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9._-]{1,64}$"
                  },
                  "protocol": {
                    "type": "string",
                    "enum": [
                      "kafka",
                      "mqtt",
                      "amqp"
                    ]
                  },
                  "space": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
                  },
                  "topics": {
                    "type": "array",
                    "description": "Kafka topics or MQTT topic filters.",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "exchange": {
                    "type": "string",
                    "description": "AMQP exchange to bind a queue to.",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "bindingKeys": {
                    "type": "array",
                    "description": "AMQP binding keys.",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 255
                    }
                  },
                  "qos": {
                    "type": "integer",
                    "description": "MQTT subscription QoS.",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "startFrom": {
                    "type": "string",
                    "description": "Where a Kafka source starts reading.",
                    "enum": [
                      "latest",
                      "earliest"
                    ]
                  },
                  "maxMessages": {
                    "type": "integer",
                    "description": "Messages kept for this source.",
                    "minimum": 1
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "additionalProperties": false
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "maxSources": {
                  "type": "integer",
                  "description": "Capture sources at most.",
                  "minimum": 1,
                  "maximum": 1000
                },
                "maxMessages": {
                  "type": "integer",
                  "description": "Messages kept per source.",
                  "minimum": 1,
                  "maximum": 100000
                },
                "maxMessageBytes": {
                  "type": "integer",
                  "description": "Body bytes kept per message; longer bodies are cut.",
                  "minimum": 1,
                  "maximum": 16777216
                },
                "maxBytes": {
                  "type": "integer",
                  "description": "Bytes of stored messages in all; the oldest are dropped beyond it.",
                  "minimum": 1048576,
                  "maximum": 1099511627776
                },
                "maxSpaceBytes": {
                  "type": "integer",
                  "description": "Bytes of stored messages per space and of the global area; a quarter of maxBytes when unset.",
                  "minimum": 65536,
                  "maximum": 1099511627776
                },
                "maxAge": {
                  "type": "string",
                  "description": "How long captured messages are kept.",
                  "pattern": "^[0-9]*[1-9][0-9]*(ms|s|m|h|d)?$"
                }
              },
              "additionalProperties": false
            },
            "allowedKafkaTopics": {
              "type": "array",
              "description": "Kafka topics sources may read (name, prefix* or *); empty: only the sources listed here, none created through the API.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowedMqttTopics": {
              "type": "array",
              "description": "MQTT topic filters sources may read (name, prefix* or *); empty: only the sources listed here, none created through the API.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowedAmqpExchanges": {
              "type": "array",
              "description": "AMQP exchanges sources may bind to (name, prefix* or *); empty: only the sources listed here, none created through the API.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mail": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9.-]*$"
        },
        "ports": {
          "type": "object",
          "properties": {
            "smtp": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "smtps": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "imap": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "imaps": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "pop3": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "pop3s": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "certKey": {
              "type": "string",
              "minLength": 1
            },
