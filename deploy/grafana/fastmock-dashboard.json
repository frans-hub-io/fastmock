{
  "title": "FastMock",
  "uid": "fastmock",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "fastmock"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(fastmock_build_info, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests/s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fastmock_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unmatched/s",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fastmock_unmatched_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fastmock_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Callbacks pending",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(fastmock_callbacks_pending{namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Stubs loaded",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fastmock_stubs_loaded{namespace=~\"$namespace\"})"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Auth failures/s",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fastmock_admin_auth_failures_total{namespace=~\"$namespace\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests by source and match",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, matched) (rate(fastmock_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{source}} matched={{matched}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Status classes",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(fastmock_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency by source (p50, p95, p99)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(fastmock_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 {{source}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(fastmock_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 {{source}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, source) (rate(fastmock_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99 {{source}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Top stubs",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (stub) (rate(fastmock_stub_hits_total{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{stub}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Callbacks by result",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, result) (rate(fastmock_callbacks_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{source}} {{result}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Callback delivery time p95",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(fastmock_callback_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Messages, gRPC, proxy, recording",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(fastmock_messages_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "kafka {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(fastmock_grpc_calls_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "grpc"
        },
        {
          "refId": "C",
          "expr": "sum(rate(fastmock_proxy_errors_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "proxy errors"
        },
        {
          "refId": "D",
          "expr": "sum(rate(fastmock_recorded_stubs_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "recorded stubs"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Chaos and faults",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (rate(fastmock_chaos_injections_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "chaos {{rule}}"
        },
        {
          "refId": "B",
          "expr": "sum by (fault) (rate(fastmock_faults_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "fault {{fault}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Errors",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (store) (rate(fastmock_store_errors_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "store {{store}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(fastmock_journal_write_errors_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "journal writes"
        },
        {
          "refId": "C",
          "expr": "sum(rate(fastmock_stub_errors_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "stub evaluation"
        },
        {
          "refId": "D",
          "expr": "sum(rate(fastmock_tls_handshake_failures_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "tls handshakes"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Admin changes and auth failures",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate(fastmock_admin_changes_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{action}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(fastmock_admin_auth_failures_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "auth failure {{reason}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Operator reconciles",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, result) (rate(fastmock_operator_reconciles_total[$__rate_interval]))",
          "legendFormat": "{{kind}} {{result}}"
        }
      ]
    }
  ]
}
